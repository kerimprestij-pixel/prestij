# PRESTİJ environment variables. Copy to .env.local (local) or set them in the hosting dashboard.
# Never commit real values. Secrets are never stored in the database or shown in the panel.

# --- Core -------------------------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:54329/prestij
# Long random string (openssl rand -base64 32). Also the HKDF root of signed links (review,
# newsletter confirm / unsubscribe): changing it voids every link already sent.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Panel admin for scripts/create-admin.ts (local: a password is generated when empty).
ADMIN_EMAIL=admin@prestij.local
ADMIN_PASSWORD=

# Local fake card gateway, local only: set it to true in .env.local to use it (it then wins over iyzico /
# PayTR). Ignored on a public https site (a production build on a non-local origin); never set it on Vercel.
PAYMENT_SIMULATOR=

# --- Client IP behind a proxy (rate limits) ----------------------------------------------------------
# Self-hosted behind a reverse proxy: the header it overwrites, e.g. x-real-ip. Not needed on Vercel.
TRUSTED_IP_HEADER=
AUTH_IP_HEADER=
AUTH_TRUSTED_PROXIES=

# --- Media storage -----------------------------------------------------------------------------------
# local (default: files under LOCAL_UPLOAD_DIR, default storage/uploads) or supabase. On Vercel the file
# system is read-only: STORAGE_DRIVER=local refuses to start uploads there, set supabase.
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=
# Supabase Storage (panel uploads go straight from the browser to the bucket through signed upload URLs).
# The bucket must exist and be public; recommended bucket limits: file size 50 MB, allowed types
# image/jpeg, image/png, image/webp, image/avif, video/mp4, video/webm.
SUPABASE_URL=
# Server-side key: a secret key (sb_secret_…, sent only as `apikey`) or the legacy service_role JWT
# (deprecated by Supabase at the end of 2026). Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media
# Optional, public by design: only if the project's API gateway asks for an apikey on signed-URL uploads.
SUPABASE_PUBLISHABLE_KEY=

# --- Card payments (day 4) ---------------------------------------------------------------------------
# Card via a provider is offered only when that provider's keys are set and it is chosen in
# /panel/ayarlar/odeme. Test mode is the panel switch.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Optional override. Default: https://sandbox-api.iyzipay.com (panel test mode on) or
# https://api.iyzipay.com. Must be https:// (http://localhost or http://127.0.0.1 only outside
# production, for scripts/payment-mock.mjs).
IYZICO_BASE_URL=
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# Optional override (same rule), default https://www.paytr.com.
PAYTR_BASE_URL=

# --- E-mail (day 4) ----------------------------------------------------------------------------------
# outbox (default outside production): writes .html/.txt files to storage/mail-outbox/.
# smtp: sends through EMAIL_SMTP_URL. In production without smtp, e-mails stay queued.
EMAIL_DRIVER=outbox
# e.g. smtps://user:pass@smtp.example.com:465
EMAIL_SMTP_URL=
# A sender on a domain verified at the mail provider, e.g. PRESTİJ <siparis@prestij.com.tr>
EMAIL_FROM=
# Optional: folder for the outbox driver (default storage/mail-outbox/).
# EMAIL_OUTBOX_DIR=

# --- Customer accounts (day 4) -----------------------------------------------------------------------
# Self-registration is open (with e-mail verification). "false" closes it in an emergency (staff
# accounts are never affected).
# AUTH_PUBLIC_SIGNUP=false

# --- Scheduled jobs (day 4) --------------------------------------------------------------------------
# Bearer secret for /api/cron/* (Vercel Cron sends "Authorization: Bearer <CRON_SECRET>"); at least
# 16 characters (openssl rand -hex 32). Without it every cron request is refused.
CRON_SECRET=

# --- Search engines (day 5) --------------------------------------------------------------------------
# Optional IndexNow key: 8-128 letters, digits and hyphens. Served at /indexnow-key.txt; changed pages are
# then reported to Bing and Yandex once a day. Empty = IndexNow off.
INDEXNOW_KEY=
