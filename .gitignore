# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database files
/.data

# panel uploads of the local storage driver (LOCAL_UPLOAD_DIR, served at /uploads) and the local mail
# outbox (EMAIL_OUTBOX_DIR); both folders are created on demand, nothing in the app needs them in the repo
/storage/

# the client's source catalogue and drafts (read by the seed's image import only; not part of the site)
/kaynak/

# local Claude Code launch config (dev only)
/.claude/
